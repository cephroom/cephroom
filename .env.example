# Copy to .env.local, then run `npm run keys:generate` and paste its three
# lines in. Everything else below has a working default.
#
# There is no DATABASE_URL. That is not an omission - see docs/CONTRACTS.md.

AUTH_URL=http://localhost:3000

# ------------------------------------------------------------ Capability keys
# Generated by `npm run keys:generate`. Ed25519, base64-encoded PEM.
#
# Rotating the signing key is the only revocation this design has: it
# invalidates every key at once and signs everybody out.
# BINDERY_SIGNING_KEY=
# BINDERY_PUBLIC_KEY=

# Derives the pseudonymous subject from a provider account id. Changing it
# gives every returning reader a new identity, so treat it as permanent.
# AUTH_SUBJECT_SECRET=

# --------------------------------------------------------------------- OAuth
# Absent, these render as disabled buttons naming the variables they need, so
# a misconfigured deployment says so out loud rather than offering less.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# A local OAuth identity provider at /api/dev-oauth, so the OAuth code path is
# exercisable without credentials only a deployment owner can create. It mocks
# the identity provider, not our auth code. Ignored in production.
AUTH_DEV_OAUTH=1

# ------------------------------------------------------------------- Billing
# Unset: a simulated counterparty under simulated-counterparties/ stands in for
# Stripe and holds its own records. Set to an sk_test_ key for Stripe test
# mode, or sk_live_ for live. Nothing else in the platform branches on it.
# STRIPE_SECRET_KEY=

# Price IDs from the Stripe dashboard. Without them the plan catalogue falls
# back to price_local_* ids, which only the simulated counterparty understands.
# STRIPE_PRICE_MEMBER_MONTHLY=
# STRIPE_PRICE_MEMBER_YEARLY=
# STRIPE_PRICE_LAB_MONTHLY=
# STRIPE_PRICE_LAB_YEARLY=

# ---------------------------------------------------------------------- Node
# Only read by node/server.ts, which is a contributor's own process rather
# than part of the platform.
# NODE_SUBJECT=
