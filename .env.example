# Copy to .env.local. The defaults below run the whole application locally
# with no external accounts.

# ---------------------------------------------------------------- Database
# A local file in development. In production, a Turso URL plus an auth token.
DATABASE_URL=file:./bindery.db
# DATABASE_AUTH_TOKEN=

# ------------------------------------------------------------------- Auth
# Generate with: npx auth secret
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_URL=http://localhost:3000

# OAuth. Absent, the buttons render disabled and name these variables rather
# than disappearing, so a misconfigured deployment says so out loud.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# A local OAuth identity provider at /api/dev-oauth, so the OAuth code path is
# exercisable without credentials only a deployment owner can create. Ignored
# when NODE_ENV is production.
AUTH_DEV_OAUTH=1

# ----------------------------------------------------------------- Billing
# Unset: checkout runs against a local stand-in that signs and delivers real
# webhook events to /api/stripe/webhook. Set to an sk_test_ key for Stripe
# test mode, or an sk_live_ key for live. Nothing else in the application
# branches on which one is in use.
# STRIPE_SECRET_KEY=

# Stripe sends this when you create the endpoint. The local stand-in signs
# with the value below, so leave it alone until you have a real one.
STRIPE_WEBHOOK_SECRET=whsec_local_development_secret

# Price IDs from the Stripe dashboard. Without them the plan catalogue falls
# back to price_local_* ids, which only the local stand-in understands.
# STRIPE_PRICE_MEMBER_MONTHLY=
# STRIPE_PRICE_MEMBER_YEARLY=
# STRIPE_PRICE_LAB_MONTHLY=
# STRIPE_PRICE_LAB_YEARLY=
